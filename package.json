{
  "name": "irobopf",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "bun scripts/run-lint.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/oxlint/tsconfig.json",
    "test": "vitest run",
    "fixture:canonico-tabular": "bun scripts/generate-canonical-fixture.ts",
    "test:liquidacion-legacy-completo": "IROBOPF_VALIDACION_LIQUIDACION_LEGACY_COMPLETA=1 vitest run tests/calculo-salario-legacy.test.ts",
    "test:legacy-completo": "IROBOPF_VALIDACION_LEGACY_COMPLETA=1 vitest run tests/auditoria-excel-pesada.test.ts",
    "test:watch": "vitest",
    "prepare": "effect-language-service patch",
    "lint:oxlint": "oxlint --disable-nested-config",
    "lint:eslint": "eslint .",
    "test:lint": "bun scripts/test-lint.mjs",
    "test:ci": "vitest run tests/fronteras-arquitectura.test.ts tests/dinero.test.ts --maxWorkers=1",
    "inventario:generar": "bun scripts/procedencia/inventario-artefacto.mjs write",
    "inventario:verificar": "bun scripts/procedencia/inventario-artefacto.mjs check",
    "test:inventario": "vitest run --config scripts/procedencia/inventario-vitest.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@uidotdev/usehooks": "^2.4.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "effect": "^4.0.0-beta.57",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "lucide-react": "^1.11.0",
    "next": "16.1.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@effect/vitest": "^4.0.0-beta.57",
    "@eslint/eslintrc": "^3",
    "@oxlint/plugins": "1.78.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "oxlint": "1.78.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
