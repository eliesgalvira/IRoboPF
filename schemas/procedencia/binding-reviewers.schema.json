                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "taskId",
              "delegationRegistry",
              "reportDirectory",
              "approvals"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "reviewers"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  ]
}
