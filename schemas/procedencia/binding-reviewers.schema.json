{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1
              },
              "delegationRegistry": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^docs/procedencia/[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "reportDirectory": {
                "type": "string",
                "pattern": "^docs/procedencia/revisiones/[^.]+$"
              }
            },
            "required": [
              "taskId",
              "delegationRegistry",
              "reportDirectory"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "reviewers"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1
              },
              "delegationRegistry": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^docs/procedencia/[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "reportDirectory": {
                "type": "string",
                "pattern": "^docs/procedencia/revisiones/[^.]+$"
