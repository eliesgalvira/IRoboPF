{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
