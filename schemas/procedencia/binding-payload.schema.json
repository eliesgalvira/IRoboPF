            "year": {
              "type": "integer",
              "minimum": 2012,
              "maximum": 2026
            },
            "territory": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "enum": [
                "EUR",
                "percent",
                "year"
              ]
            },
            "claim": {
              "type": "string",
              "minLength": 1
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "completeRule": {
              "const": false
            }
          },
          "required": [
            "year",
            "territory",
            "unit",
            "claim",
            "conditions",
            "completeRule"
          ],
          "additionalProperties": false
        },
        "conversion": {
          "const": "identity"
        },
        "citation": {
          "type": "object",
          "properties": {
            "path": {
