{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "engineLocations"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["accepted", "needs-evidence", "rejected", "pending"]
    },
    "decision": {
      "enum": ["accepted", "needs-evidence", "rejected", "pending"]
    },
    "engineLocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^lib/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.tsx?#[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^lib/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.tsx?$"
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      }
    }
  },
  "oneOf": [
    {
      "required": ["status"],
      "not": {
        "required": ["decision"]
      }
    },
    {
      "required": ["decision"],
      "not": {
        "required": ["status"]
      }
    }
  ]
}
