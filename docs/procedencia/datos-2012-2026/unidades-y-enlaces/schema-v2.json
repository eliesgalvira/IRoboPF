            },
            "required": [
              "start",
              "end",
              "offsetEncoding"
            ]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "year": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1900,
                  "maximum": 2200
                },
                "territory": {
                  "type": "string",
                  "minLength": 1
                },
                "row": {
                  "type": "string",
                  "minLength": 1
                },
                "column": {
                  "type": "string",
                  "minLength": 1
                },
                "subject": {
                  "type": "string",
                  "minLength": 1
                },
                "conditions": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "year",
                "territory",
                "row",
                "column",
                "subject",
                "conditions"
              ]
            }
          },
          "adapter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "start",
              "end",
              "quote"
            ]
          }
        },
        "required": [
          "unit",
          "sourceSha256",
          "quote",
          "position",
          "targets"
        ]
      }
    },
    "retirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "previousBinding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
