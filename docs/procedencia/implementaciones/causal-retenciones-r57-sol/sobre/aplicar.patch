+  for (const o of e.outputs) {
+    const root = events.get(o.root);
+    if (
+      !g.outputBindings.some((b) => b.siteId === o.siteId) ||
+      root?.operation !== "transport" ||
+      root.property !== o.siteId ||
+      root.value !== o.decimal
