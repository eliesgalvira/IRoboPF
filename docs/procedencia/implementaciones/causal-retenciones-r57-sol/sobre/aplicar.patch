+    switch (n.op) {
+      case "literal":
+        value = n.data.value
+        break
+      case "regex":
+        value = new RegExp(n.data.pattern, n.data.flags)
+        break
+      case "global":
+        value = global(n.data.name)
+        break
+      case "local":
