+  if (e.annualBindings.length !== 3) reject("fases");
+  for (const b of g.annualBindings)
+    if (
+      !e.annualBindings.some(
+        (x) =>
+          x.name === b.name &&
+          events.get(x.producer)?.operation === "annual-binding",
