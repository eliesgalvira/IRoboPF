+    )
+      reject("selección/semilla trabajo")
+    for (const event of events)
+      if (
+        event.operation === "binary" &&
+        (!event.edges.some((x) => x.role === "left") ||
+          !event.edges.some((x) => x.role === "right"))
+      )
