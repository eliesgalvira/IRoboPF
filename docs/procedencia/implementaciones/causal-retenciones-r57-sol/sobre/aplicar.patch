+  }
+  const replay = executeCausalRetenciones(
+    g,
+    caso,
+    contexto,
+    execution,
+  ).evidence;
+  if (digest(replay) !== digest(e))
+    reject("relaciones/propiedad/unidades/fuente/selección no reproducidas");
+  return true;
+}
