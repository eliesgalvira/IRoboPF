+test("familia: correspondencia estructural miembro→argumento en folds, vacío y repetidos", () => {
+  for (const descendientes of [
+    [],
+    ...cases
+      .filter(([name]) => name === "familia repetida excluida")
+      .map(([, p]) => p.descendientes),
