+export function verifyCausalSS(
+  g: SSFragment,
+  evidence: ExecutionEvidence,
+  caso: SSCase,
+  contexto: SSContext,
+  execution: string,
+): true {
+  requireExecutableSS(g)
+  const reject: (message: string) => never = (message) => {
+    throw Error("Evidencia insuficiente: " + message)
+  }
