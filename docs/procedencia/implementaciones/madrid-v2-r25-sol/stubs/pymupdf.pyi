"""Frontera tipada de las operaciones PDF usadas; no sustituye validación runtime.

Firmas limitadas al subconjunto usado de PyMuPDF 1.26.7 instalado por uv.lock.
No introduce Any ni suprime diagnósticos de módulos sin py.typed.
"""
from collections.abc import Iterator, Sequence
from types import TracebackType

VersionBind: str
VersionFitz: str

class Colorspace: ...
csRGB: Colorspace

class Rect:
    def __init__(self, coordinates: Sequence[float]) -> None: ...
    def __iter__(self) -> Iterator[float]: ...

class Pixmap:
    def tobytes(self, output: str) -> bytes: ...

class Page:
    rect: Rect
    mediabox: Rect
    cropbox: Rect
    rotation: int
    def get_text(self, option: str = ..., *, clip: Rect | None = ..., flags: int = ..., sort: bool = ...) -> str: ...
    def get_pixmap(self, *, dpi: int, clip: Rect | None = ..., colorspace: Colorspace = ..., alpha: bool = ..., annots: bool = ...) -> Pixmap: ...

class Document:
    def __enter__(self) -> Document: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_value: BaseException | None, traceback: TracebackType | None) -> None: ...
    def __getitem__(self, index: int) -> Page: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Page]: ...

def open(filename: str | None = ..., *, stream: bytes | None = ...) -> Document: ...
