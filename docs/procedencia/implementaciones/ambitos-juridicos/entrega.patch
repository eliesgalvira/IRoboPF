+        f.dependencias,
+        (h) => f.objetos.get(h)
+      ),
+    /aprobación exacta/
+  )
+})
+
+test("claves de delegación duplicadas con tareas distintas son ambiguas", () => {
+  const f = fixture()
+  function replace(path, value) {
