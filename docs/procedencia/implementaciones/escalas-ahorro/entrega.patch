+const VALENCIA_2014_2016 = filas([
+  ["0", "0", ".119"],
+  ["17707.20", "2107.16", ".1392"],
+  ["33007.20", "4236.92", ".1845"],
+  ["53407.20", "8000.72", ".2148"],
