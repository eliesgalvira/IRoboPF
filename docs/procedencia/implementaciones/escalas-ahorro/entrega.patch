+  ["175000.20", "34668.90", ".2348"],
+])
+const CATALUNYA_2020_2021 = filas([
+  ["0", "0", ".12"],
+  ["17707.20", "2124.86", ".14"],
+  ["33007.20", "4266.86", ".185"],
+  ["53407.20", "8040.86", ".215"],
