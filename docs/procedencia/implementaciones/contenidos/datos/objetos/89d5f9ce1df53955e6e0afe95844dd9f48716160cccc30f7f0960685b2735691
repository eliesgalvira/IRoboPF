{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "edition",
    "acceptance",
    "base",
    "baseline",
    "transport",
    "annex",
    "dependencies",
    "unresolvedReferences",
    "exclusions"
  ],
  "properties": {
    "format": {
      "const": "irobopf-ampliacion-local"
    },
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "edition": {
      "type": "integer",
      "const": 3
    },
    "acceptance": {
      "const": "ninguna"
    },
    "base": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "baseline": {
      "$ref": "#/$defs/fingerprint"
    },
    "transport": {
      "$ref": "#/$defs/fingerprint"
    },
    "annex": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "sha512",
          "size",
          "class",
          "sources",
          "acquisitions",
          "references"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sha512": {
            "type": "string",
            "pattern": "^[a-f0-9]{128}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "class": {
            "enum": [
              "facsimil",
              "documento-primario-candidato",
              "captura-secundaria-URL-oficial"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?:checkout:|parent:)(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.\\[\\]/-]+$"
            }
          },
          "acquisitions": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "sha512",
                "size",
                "retrievedAt",
                "httpStatus",
                "canonicalUrl",
                "finalUrl",
                "source",
                "sourceSha256"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sha512": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{128}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "retrievedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "httpStatus": {
                  "const": 200,
                  "type": "integer"
                },
                "canonicalUrl": {
                  "type": "string"
                },
                "finalUrl": {
                  "type": "string"
                },
                "source": {
                  "$ref": "#/$defs/path"
                },
                "sourceSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "references": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/path"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "sha512",
          "size"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sha512": {
            "type": "string",
            "pattern": "^[a-f0-9]{128}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "unresolvedReferences": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "sources"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/path"
            }
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "reason": {
            "enum": [
              "URL-no-admitida",
              "indice-mayor-16MiB"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.\\[\\]/-]+$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "sha512",
        "size"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sha512": {
          "type": "string",
          "pattern": "^[a-f0-9]{128}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
