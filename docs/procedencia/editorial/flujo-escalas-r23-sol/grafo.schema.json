    "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "output", "inputs", "role", "formula", "condition", "evidence", "review", "legalAcceptance"], "properties": {
      "id": {"type": "string"}, "output": {"type": "object", "required": ["file", "symbol", "property"]},
      "inputs": {"type": "array", "items": {"type": "string"}},
      "role": {"enum": ["value", "selection", "domain"]}, "formula": {"type": "string", "minLength": 1},
      "condition": {"type": "string", "minLength": 1}, "evidence": {"type": "object", "required": ["source", "expression", "rangeKind"]},
      "review": {"const": "pending-independent"}, "legalAcceptance": {"const": false}
    }}}
  }
}
