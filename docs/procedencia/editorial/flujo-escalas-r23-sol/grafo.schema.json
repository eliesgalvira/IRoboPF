{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "head", "inventory", "direction", "sites", "edges", "wiringAllowed", "globalClosure"],
  "properties": {
    "version": {"const": 2},
    "head": {"const": "07c07e6376a72f229be735a904ecf36517a1b571"},
    "inventory": {"type": "object"},
    "direction": {"const": "output-to-input"},
    "wiringAllowed": {"const": false},
    "globalClosure": {"const": false},
