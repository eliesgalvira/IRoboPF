{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Superposición editorial B candidata, separada de Entidad",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "titulo",
      "dominio",
      "objetivo",
      "ambito",
      "unidad",
      "codigo",
      "expresion",
      "secciones",
      "pendientes",
      "aceptacionFiscalCompleta",
      "contrarrevision",
      "derivacionCompartida"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "titulo": {
        "type": "string",
        "minLength": 1
      },
      "dominio": {
        "enum": [
          "trabajo",
          "capital",
          "pagos",
          "ss",
          "retencion",
          "actividad"
        ]
      },
      "objetivo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot",
          "siteId",
          "sujeto"
        ],
        "properties": {
          "snapshot": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "siteId": {
            "type": [
              "string",
              "null"
            ]
          },
          "sujeto": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      },
      "ambito": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ejercicios",
          "territorio",
          "calidad",
          "contrato"
        ],
        "properties": {
          "ejercicios": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 2012,
              "maximum": 2026
            }
          },
          "territorio": {
            "type": "string",
            "minLength": 1
          },
          "calidad": {
            "type": "string",
            "minLength": 1
          },
          "contrato": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "unidad": {
        "enum": [
          "EUR",
          "percent"
        ]
      },
      "codigo": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "archivo",
            "sha256",
            "localizador",
            "selector"
          ],
          "properties": {
            "archivo": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "localizador": {
              "type": "string",
              "minLength": 1
            },
            "selector": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      },
      "expresion": {
        "type": "string",
        "minLength": 1
      },
      "secciones": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "formula",
          "derivacion",
          "norma",
          "evidencia",
          "bordes"
        ],
        "properties": {
          "formula": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "estado",
              "texto"
            ],
            "properties": {
              "estado": {
                "enum": [
                  "candidata",
                  "pendiente",
                  "no-aplica"
                ]
              },
              "texto": {
                "type": "string",
                "minLength": 1
              },
              "citas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "derivacion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "estado",
              "texto"
            ],
            "properties": {
              "estado": {
                "enum": [
                  "candidata",
                  "pendiente",
                  "no-aplica"
                ]
              },
              "texto": {
                "type": "string",
                "minLength": 1
              },
              "citas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "norma": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "estado",
              "texto"
            ],
            "properties": {
              "estado": {
                "enum": [
                  "candidata",
                  "pendiente",
                  "no-aplica"
                ]
              },
              "texto": {
                "type": "string",
                "minLength": 1
              },
              "citas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "evidencia": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "estado",
              "texto"
            ],
            "properties": {
              "estado": {
                "enum": [
                  "candidata",
                  "pendiente",
                  "no-aplica"
                ]
              },
              "texto": {
                "type": "string",
                "minLength": 1
              },
              "citas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "bordes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "estado",
              "texto"
            ],
            "properties": {
              "estado": {
                "enum": [
                  "candidata",
                  "pendiente",
                  "no-aplica"
                ]
              },
              "texto": {
                "type": "string",
                "minLength": 1
              },
              "citas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "pendientes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "afirmacion",
            "falta"
          ],
          "properties": {
            "afirmacion": {
              "type": "string",
              "minLength": 1
            },
            "falta": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "aceptacionFiscalCompleta": {
        "const": false
      },
      "contrarrevision": {
        "const": "pendiente"
      },
      "derivacionCompartida": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "archivo",
          "seccion"
        ],
        "properties": {
          "archivo": {
            "type": "string",
            "minLength": 1
          },
          "seccion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
