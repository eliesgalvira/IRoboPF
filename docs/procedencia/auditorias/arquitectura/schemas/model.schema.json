            "type": "integer",
            "minimum": 2012,
            "maximum": 2026
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "territories": {
          "type": "array",
          "items": {
            "enum": [
              "ES",
              "ES-AN",
              "ES-AR",
              "ES-AS",
              "ES-CN",
              "ES-CB",
              "ES-CL",
              "ES-CM",
              "ES-CT",
              "ES-EX",
              "ES-GA",
              "ES-IB",
              "ES-RI",
              "ES-MD",
              "ES-MC",
              "ES-NC",
              "ES-PV",
              "ES-VC",
              "ES-CE",
              "ES-ML",
              "ES-VI",
              "ES-BI",
              "ES-SS",
              "simulada-estatal"
