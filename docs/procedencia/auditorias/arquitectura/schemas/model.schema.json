        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "aceptada",
                  "rechazada",
                  "objetada"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reviewerId",
              "reportRef",
              "examined",
              "reasonEs"
            ]
          }
        }
      ]
    },
    "Edge": {
      "type": "object",
