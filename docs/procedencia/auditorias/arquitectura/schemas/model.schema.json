{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irobopf.com/contracts/procedencia/v1/model.schema.json",
  "title": "Propuesta de contratos de procedencia IRoboPF; pendiente de contrarrevisión",
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*([.-][a-z0-9]+)*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "Blob": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sha512": {
          "type": "string",
          "pattern": "^[a-f0-9]{128}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^sha256/[a-f0-9]{64}$"
        }
      },
      "required": [
        "sha256",
        "sha512",
        "size",
        "mimeType",
        "path"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "years": {
          "type": "array",
