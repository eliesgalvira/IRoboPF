          },
          "minItems": 1,
          "uniqueItems": true
        },
        "regime": {
          "enum": [
            "comun",
            "foral",
            "legacy-simulado",
            "general",
            "no-fiscal"
          ]
        },
        "validFrom": {
          "type": "string",
          "format": "date"
        },
        "validToExclusive": {
          "type": "string",
          "format": "date"
        },
        "timeBasis": {
          "enum": [
            "devengo",
            "pago",
            "periodo-cotizacion",
            "fecha-fallecimiento",
            "ejercicio-anual",
            "no-fiscal"
          ]
        },
        "conditionEs": {
          "type": "string",
          "minLength": 1
        },
        "conditionRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "inheritance": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "direct"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "inherited"
                },
                "from": {
                  "$ref": "#/$defs/Ref"
                },
                "continuityRuleRefs": {
                  "type": "array",
