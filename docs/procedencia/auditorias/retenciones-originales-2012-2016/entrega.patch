+import sys
+import json
+import urllib.parse
+import datetime
+from pathlib import Path
+from typing import NotRequired, TypedDict
+
+
+sys.path.insert(0,str(Path('tools/procedencia').resolve()))
+from descargar import download,DEFAULT_HOSTS
+
+
+class Intento(TypedDict):
+    url: str
+    attemptedAt: str
+    document: NotRequired[dict[str, object]]
+    error: NotRequired[str]
+    httpStatus: NotRequired[int | None]
+
+
+root=Path('.cache/procedencia/retenciones-originales-2012-2016')
+out=Path('docs/procedencia/auditorias/retenciones-originales-2012-2016')
+for url in sys.argv[1:]:
+    entry: Intento = {'url':url,'attemptedAt':datetime.datetime.now(datetime.timezone.utc).isoformat()}
+    try:
+        entry['document']=download(url,root,hosts=DEFAULT_HOSTS|{urllib.parse.urlsplit(url).hostname,'web.archive.org','www2.agenciatributaria.gob.es'},max_bytes=12000000)
+        print(entry['document']['sha256'],url,flush=True)
+    except Exception as e:
+        entry['error']=str(e)
+        entry['httpStatus']=getattr(e,'code',None)
+        print(entry['error'],url,flush=True)
+    with (out/'adquisicion.jsonl').open('a') as f:
+        f.write(json.dumps(entry,ensure_ascii=False)+'\n')
