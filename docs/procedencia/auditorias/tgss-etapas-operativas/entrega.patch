00</ValorBase> \n \n \n \n \n \n \n \n \n<ValorCuotaTrabajador>00000000000</ValorCuotaTrabajador> \n \n \n \n \n \n \n \n \n<ValorCuotaEmpresarial>00000001100</ValorCuotaEmpresarial> \n \n \n \n \n \n \n \n \n<ValorCuotaTotal>00000001100</ValorCuotaTotal> \n \n \n \n \n \n \n \n</DatoCalculado> \n \n \n \n \n \n \n \n<DatoCalculado> \n \n \n \n \n \n \n \n \n<Codigo>698</Codigo> \n \n \n \n \n \n \n \n \n<ValorBase>00000000000</ValorBase> \n \n \n \n \n \n \n \n \n<ValorCuotaTrabajador>00000000000</ValorCuotaTrabajador> ",
