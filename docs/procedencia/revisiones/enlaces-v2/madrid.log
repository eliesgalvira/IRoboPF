  escala: EscalaAutonomicaIrpf2025
): EscalaAutonomicaIrpf2020 =>
  escala2020({
    comunidadAutonoma: escala.comunidadAutonoma,
    nombre: escala.nombre,
    tramos: escala.tramos,
  })

