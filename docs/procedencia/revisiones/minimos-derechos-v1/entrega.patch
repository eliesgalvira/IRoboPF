+  sujetoId,
+  fechaNacimiento,
+  edadDevengo: 2025 - Number(fechaNacimiento.slice(0, 4)),
+  vivoAlDevengo: true,
+  rentasNoExentasCentimos: 0,
+  declaracion: { modalidad: "no-presenta" },
+  discapacidad: sinDiscapacidad,
+  titulares,
+  titularesCompletos: true,
