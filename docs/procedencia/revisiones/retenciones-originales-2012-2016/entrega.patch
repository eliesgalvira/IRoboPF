+[
+  {
+    "id": "RO1216-01",
+    "decision": "confirmado-acotado",
+    "hallazgo": "Los siete algoritmos están recuperados; 19 originales y 191 citas/renders coinciden. CDX SHA1 se cotejó contra bytes, sin autenticar históricamente al emisor.",
+    "objecionExperta": "Una captura no equivale a copia autenticada.",
+    "coste": "Conservar clasificación secundaria, no habilitar ejercicios.",
+    "aceptacionFiscal": false
+  },
+  {
+    "id": "RO1216-02",
+    "decision": "reserva-sustantiva",
+    "hallazgo": "El índice archivado a03f2252d4e3… anuncia versión14/07 y corrección de causas6+11. El PDF e0f7f92d96c6… portada13/07 mantiene p34 RESICEME=S y RENCEME=N en azul SIN tachado visible. La pérdida de residencia no alcanza esa rama. No se demuestra que los bytes contengan la corrección anunciada.",
+    "objecionExperta": "No se puede declarar simple errata de portada sin cotejar la rama que motivó la revisión.",
+    "coste": "Recuperar versión corregida o aclaración del emisor; bloquear solo esa rama y la aceptación de versión completa.",
+    "aceptacionFiscal": false
+  },
+  {
+    "id": "RO1216-03",
+    "decision": "indeterminado",
+    "hallazgo": "PDF2016 portada24/11/2015. La búsqueda acotada localizó anuncio secundario de versión22/12/2015, pero no testimonio primario nuevo que identifique sus bytes ni un segundo algoritmo.",
+    "objecionExperta": "Una noticia no permite rebautizar el documento ni afirmar inexistencia de revisión.",
+    "coste": "Mantener dos fechas con función distinta; no hacerlas intervalos legales.",
+    "aceptacionFiscal": false
+  },
+  {
+    "id": "RO1216-04",
+    "decision": "confirmado-como-limite",
+    "hallazgo": "No se ha acreditado exhaustividad de versiones anteriores a las correcciones de 2015.",
+    "objecionExperta": "Consulta CDX acotada no prueba inexistencia.",
+    "coste": "Preservar siete testimonios sin llamarlos catálogo histórico exhaustivo.",
+    "aceptacionFiscal": false
+  },
+  {
+    "id": "RO1216-05",
+    "decision": "confirmado-por-lectura-actual",
+    "hallazgo": "Catálogo de la base comienza2017; los rojos históricos contra otra versión no son defectos actuales reproducidos.",
+    "objecionExperta": "Un contrato no implementado no es un cálculo numérico incorrecto.",
+    "coste": "Sin rojo artificial ni cambios de motor.",
+    "aceptacionFiscal": false
+  },
+  {
+    "id": "RO1216-06",
+    "decision": "confirmado-con-casos",
+    "hallazgo": "133 casos Decimal: fronteras de escala y reducción, siete escenarios ordinarios, redondeo y tres subpasos de regularización. Las cuotas fijas y los cortes .20 permanecen literales.",
+    "objecionExperta": "Casos documentales no son respuesta AEAT ni prueba del motor.",
+    "coste": "No incorporarlos a suite general sin decisión de contrato.",
+    "aceptacionFiscal": false
+  },
+  {
+    "id": "RO1216-07",
+    "decision": "confirmado-y-ampliado",
+    "hallazgo": "MOVILGEO de 2014 está tachado en 2016 p22. Además p21 tacha y CAMBIORESI=2015; p4 tacha obligatoriedad de ese dato. Ayuda 2016 pp11–12 corrobora el cambio de régimen.",
+    "objecionExperta": "La extracción conserva condiciones eliminadas; color solo no significa tachado.",
+    "coste": "Anotar marcas fuera del texto original; nueva guarda de movilidad por hechos.",
+    "aceptacionFiscal": false
+  },
+  {
+    "id": "RRO-08",
+    "decision": "reserva-de-subpaso",
+    "hallazgo": "RD1003/2014 p7 exige limitar otros gastos después de minoraciones a) y b); PDFs 2015/2016 p21 limitan por RETRIB-COTIZACIONES. Se conserva la objeción RET1219-21, ahora también localizada en originales históricos.",
+    "objecionExperta": "Una coincidencia en base final cero puede ocultar diferencia de subpaso.",
+    "coste": "No promover todo el paso gastos sin resolver la remisión.",
+    "aceptacionFiscal": false
+  },
+  {
+    "id": "RRO-09",
+    "decision": "laguna-documental-parcial-resuelta",
+    "hallazgo": "Los PDF2012–2014 pp22/28 expresan PENSION e HIJOS por separado y los suman. Ya existe algoritmo para examinar RET1219-34; no repetir como bloqueo que faltan esos documentos.",
+    "objecionExperta": "La suma informática no agota la interpretación jurídica de pensionista o más de dos descendientes.",
+    "coste": "Actualizar alcance del pendiente, conservar reserva de interpretación.",
+    "aceptacionFiscal": false
+  },
+  {
+    "id": "RRO-10",
+    "decision": "corroboracion-normativa",
+    "hallazgo": "RD633/2015 pp23–24 permite conservar topes47/24 hasta 31julio cuando la regularización se difiere a agosto.",
+    "objecionExperta": "Seleccionar escala y tope con relojes distintos crea un procedimiento híbrido.",
+    "coste": "Selector temporal debe trasladar opción del pagador a ambas reglas.",
+    "aceptacionFiscal": false
+  }
+]
