+    "quote": "«Artículo 15 quáter. Escala autonómica.",
+    "extraction": "get_textbox",
+    "completeRuleAcceptance": false
+  },
+  {
+    "documentSha256": "09f01627f64790629169c728da9292d81e46a99392641597d1cc93b1b1799154",
