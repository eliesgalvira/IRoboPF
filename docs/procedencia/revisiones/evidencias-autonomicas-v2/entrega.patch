+    "quote": "Disposición final cuarta. Entrada en vigor.",
+    "extraction": "get_textbox",
+    "completeRuleAcceptance": false
+  },
+  {
+    "documentSha256": "0ed3161792ae3a79877c8d9a533447a3f04db4cd31078be29f0b2c2fefd4c70d",
