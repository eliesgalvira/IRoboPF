# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# generated legacy fixture
/Auditoria_Integral_Nominas_e_Inflacion_2012_2026.xlsx

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.impeccable/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# Originales y artefactos temporales de la auditoría (manifiestos sí versionados)
/.cache/procedencia/
/.cache/orquestador-preservacion/
/.cache/orquestador-recepcion/
/.cache/evidencia-test-*/
/.cache/publicacion-evidencia-*/
/.cache/redondeo-tgss-mensual/
/.cache/integracion-r11-diff.txt
__pycache__/
*.pyc
/tools/procedencia/.venv/
# Copias de ejecución de revisores; los manifiestos seleccionan la entrega.
/docs/procedencia/revisiones/*/scratch/
/docs/procedencia/revisiones/*/validacion/
/docs/procedencia/revisiones/*/mypy-cache/
/docs/procedencia/revisiones/*/tmp/
/docs/procedencia/revisiones/*/checkout-validacion/
/docs/procedencia/revisiones/*/lint-input/
# Log íntegro conservado por el padre como gzip con hashes en la recepción.
/docs/procedencia/revisiones/conexion-anual-v1/lint.log

# Originales recibidos por hash; copia verificada fuera de T3 en la caché de procedencia.
/docs/procedencia/revisiones/evidencias-estatales-v2/cas/
/docs/procedencia/revisiones/retenciones-2015-2016-sol/fuentes/
/docs/procedencia/revisiones/retenciones-2012-2014-sol/primarios/sha256/
# Reproducciones propias R21; conservar los bytes, excluirlos del respaldo de código.
/.cache/contratos-publicacion-r19-sol/
/.cache/preservacion-v3-sol/
/.cache/preservacion-r21-mypy/
# Ensayos sintéticos R24/R26; conservarlos fuera del respaldo de código.
/.cache/preservacion-v4-r24-sol/
/.cache/preservacion-v4-sol/
# Ensayos propios R30; conservados en disco, sin incluir CAS ni copias del motor.
/.cache/cas-local-r27-sol/
/.cache/nominal-r29/
/.cache/nominal-software-pruebas/
/.cache/preservacion-v5-sol/
# Restauración y registros de ensayo R34: conservados localmente, fuera de Git.
/.cache/incorporacion-lote-r32/
# Arnés y testigos regenerables de puertos; entrega y hashes en docs/procedencia.
/.cache/puertos-composicion-r47-sol/
# Originales locales para publicar el lote: se restauran desde el paquete v5 fijado.
# Los fixtures que ya estaban versionados permanecen en su historia.
/docs/procedencia/corpus/fixtures/sha256/

